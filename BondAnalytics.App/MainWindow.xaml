<Window x:Class="BondAnalytics.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:loc="clr-namespace:App.Localization"
        Title="{loc:Loc Header.Title}" Height="900" Width="1480"
        MinHeight="680" MinWidth="1080"
        Language="{Binding Localization.XmlLanguage}"
        Background="#F2F4F1" Foreground="#1D2C2A"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#1D2C2A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#687773"/>
        <SolidColorBrush x:Key="LineBrush" Color="#DCE3DE"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#D7E9E1"/>
            <Setter Property="Foreground" Value="#163E35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E8EDE9"/>
            <Setter Property="Foreground" Value="#53615C"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#DCE3DE"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEF1EE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F6F2"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E4F0E9"/>
                    <Setter Property="Foreground" Value="#1D2C2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProfitCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#53615C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProfitNegative}" Value="True">
                    <Setter Property="Foreground" Value="#B4463E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProfitPositive}" Value="True">
                    <Setter Property="Foreground" Value="#23745B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Foreground" Value="#687773"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#173B34"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChartListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#42524C"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E3EFE8"/>
                                <Setter Property="Foreground" Value="#173B34"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF4F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#173B34" Padding="26,17">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Header.Brand}" Foreground="#A9C8B9" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="{loc:Loc Header.Title}" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#284B43" CornerRadius="4" Padding="12,8" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#E4A05F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsApiConnected}" Value="True">
                                                <Setter Property="Fill" Value="#6ED3A3"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ApiStatusText}" Value="Нет подключения">
                                                <Setter Property="Fill" Value="#E1786B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ApiStatusText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ApiStatusDetails}" Foreground="#C0D3CB" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="340" Margin="16,3,0,0"/>
                    </StackPanel>
                </Border>
                <Button Grid.Column="2" Content="{loc:Loc Nav.Analytics}" Command="{Binding ShowAnalyticsCommand}"
                    Style="{StaticResource ActionButton}" Background="#D7E9E1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <Button Grid.Column="3" Content="{loc:Loc Nav.Plan}" Command="{Binding ShowInvestmentPlanCommand}"
                    Style="{StaticResource ActionButton}" Background="#E5EBDD" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <Button Grid.Column="4" Content="{Binding Localization.LanguageButtonText}" Command="{Binding ToggleLanguageCommand}"
                    Style="{StaticResource ActionButton}" Background="#DCE6EA" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <Button Grid.Column="5" Content="{loc:Loc Nav.Refresh}" Command="{Binding RefreshCommand}"
                        Style="{StaticResource ActionButton}" Background="#E9F2EC" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,18,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16,13" Margin="0,0,8,0" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Metric.MarketValue}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding TotalPortfolioValue, StringFormat={}{0:N0} ₽}" Style="{StaticResource MetricValue}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16,13" Margin="4,0" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Metric.AccruedInterest}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding TotalNkd, StringFormat={}{0:N0} ₽}" Style="{StaticResource MetricValue}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16,13" Margin="4,0" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Metric.PositionResult}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding TotalProfit, StringFormat={}{0:+#,0;-#,0;0} ₽}" Style="{StaticResource MetricValue}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16,13" Margin="8,0,0,0" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Metric.PositionCount}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding PortfolioCount}" Style="{StaticResource MetricValue}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" Margin="24,0,24,12" Background="Transparent" BorderThickness="0">
            <TabItem Header="{loc:Loc Nav.Portfolio}">
                <Grid Background="White" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="18,14" LastChildFill="False">
                        <TextBlock Text="{loc:Loc Portfolio.Positions}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <TextBlock Text="{loc:Loc Portfolio.FilterLabel}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="170" Height="32" ItemsSource="{Binding Localization.Filters}" SelectedIndex="{Binding SelectedFilterIndex}"
                                  VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Portfolio}"
                              AutoGenerateColumns="False" CanUserSortColumns="True" IsReadOnly="True"
                              CanUserResizeRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                              GridLinesVisibility="None" Background="White" BorderThickness="0"
                              Margin="12,0,12,12" RowHeight="42"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Table.Ticker}" Binding="{Binding Ticker}" Width="90"/>
                            <DataGridTextColumn Header="{loc:Loc Table.Name}" Binding="{Binding Name}" Width="2*" MinWidth="180"/>
                            <DataGridTextColumn Header="{loc:Loc Table.Quantity}" Binding="{Binding Quantity, StringFormat={}{0:N0}}" Width="85"/>
                            <DataGridTextColumn Header="{loc:Loc Table.AveragePrice}" Binding="{Binding AveragePrice, StringFormat={}{0:N2}}" Width="110"/>
                            <DataGridTextColumn Header="{loc:Loc Table.CurrentPrice}" Binding="{Binding CurrentPrice, StringFormat={}{0:N2}}" Width="110"/>
                            <DataGridTextColumn Header="{loc:Loc Table.Result}" Binding="{Binding Profit, StringFormat={}{0:+#,0.00;-#,0.00;0.00}}" Width="110" CellStyle="{StaticResource ProfitCellStyle}"/>
                            <DataGridTextColumn Header="{loc:Loc Table.Value}" Binding="{Binding TotalValue, StringFormat={}{0:N0}}" Width="110"/>
                            <DataGridTextColumn Header="{loc:Loc Table.PositionNkd}" Binding="{Binding TotalAccruedInterest, StringFormat={}{0:N2}}" Width="110"/>
                            <DataGridTextColumn Header="{loc:Loc Table.ValueWithNkd}" Binding="{Binding FullValue, StringFormat={}{0:N0}}" Width="110"/>
                            <DataGridTextColumn Header="{loc:Loc Table.Nominal}" Binding="{Binding Nominal, StringFormat={}{0:N2}}" Width="95"/>
                            <DataGridTextColumn Header="{loc:Loc Table.Coupon}" Binding="{Binding Coupon, StringFormat={}{0:N2}}" Width="85"/>
                            <DataGridTextColumn Header="{loc:Loc Table.CouponsPerYear}" Binding="{Binding CouponsPerYear}" Width="95"/>
                            <DataGridTextColumn Header="{loc:Loc Table.NextCoupon}" Binding="{Binding NextCouponDate, StringFormat={}{0:dd.MM.yyyy}}" Width="125"/>
                            <DataGridTextColumn Header="{loc:Loc Table.CurrentYield}" Binding="{Binding CurrentYield, StringFormat={}{0:P2}}" Width="135"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Графики">
                <Grid Background="#F2F4F1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14" Margin="0,0,12,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="4,2,4,12">
                                <TextBlock Text="Графики" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="Выберите срез портфеля" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding AvailableCharts}" SelectedIndex="{Binding SelectedChartIndex, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource ChartListItem}" BorderThickness="0"
                                     Background="Transparent" FontSize="13"
                                     SelectionChanged="ChartList_SelectionChanged"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="4,0,4,10">
                                <TextBlock Text="{Binding SelectedChart}" FontSize="18" FontWeight="SemiBold" Foreground="#1D2C2A"/>
                                <TextBlock Text="{Binding SelectedChartDescription}" FontSize="11" Foreground="#687773" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <oxy:PlotView x:Name="Plot" Model="{Binding PlotModel}"
                                              PreviewMouseDown="Plot_PreviewMouseDown"/>
                                <Border x:Name="TooltipPanel" Background="#173B34" BorderBrush="#DCE3DE"
                                        BorderThickness="1" CornerRadius="3" Padding="9"
                                        Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        IsHitTestVisible="False">
                                    <TextBlock x:Name="TooltipText" Foreground="White" FontSize="12"/>
                                </Border>
                            </Grid>
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding CurrentCouponChart.LegendItems}" Margin="4,10,4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,7" VerticalAlignment="Center">
                                            <Rectangle Width="9" Height="9" Fill="{Binding Color}" RadiusX="1" RadiusY="1" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#53615C" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Аналитика счёта">
                <Grid Background="#F2F4F1" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*" MinHeight="190"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Период" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Width="130" Height="32" ItemsSource="{Binding PeriodAnalytics.PeriodOptions}"
                                      SelectedItem="{Binding PeriodAnalytics.SelectedRange}" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="С" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker Width="140" SelectedDate="{Binding PeriodAnalytics.FromDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                            <TextBlock Text="По" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker Width="140" SelectedDate="{Binding PeriodAnalytics.ToDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,0"/>
                            <Button Content="Обновить аналитику" Command="{Binding PeriodAnalytics.LoadCommand}"
                                    Style="{StaticResource ActionButton}" Background="#173B34" Foreground="White"/>
                        </DockPanel>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,10">
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12,10" Margin="0,0,6,0" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="ПОПОЛНЕНИЯ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding PeriodAnalytics.DepositsText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PeriodAnalytics.DepositCountText, StringFormat={}Операций: {0}}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12,10" Margin="3,0" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="ВЫВОДЫ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding PeriodAnalytics.WithdrawalsText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PeriodAnalytics.WithdrawalCountText, StringFormat={}Операций: {0}}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12,10" Margin="3,0" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="ЧИСТЫЙ ПОТОК" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding PeriodAnalytics.NetCashFlowText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Пополнения минус выводы" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12,10" Margin="3,0" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="СДЕЛКИ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding PeriodAnalytics.TradeCountText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                <TextBlock Text="Покупки и продажи" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12,10" Margin="3,0" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="СТОИМОСТЬ СЕЙЧАС" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding PeriodAnalytics.CurrentPortfolioValueText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Валюта RUB" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12,10" Margin="3,0" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="РЕЗУЛЬТАТ ПЕРИОДА" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding PeriodAnalytics.PeriodProfitText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Стоимость минус внешние потоки" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12,10" Margin="6,0,0,0" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="ДОХОДНОСТЬ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding PeriodAnalytics.PeriodReturnText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="С учётом дат пополнений" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16,12" Margin="0,0,0,10">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="История стоимости портфеля" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Пополнения и выводы отмечены разными маркерами; наведите курсор на маркер, чтобы увидеть сумму."
                                           FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,12,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Content="Открыть график" Command="{Binding PeriodAnalytics.OpenPortfolioChartCommand}"
                                    Style="{StaticResource ActionButton}" Background="#173B34" Foreground="White"
                                    DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8">
                        <DataGrid ItemsSource="{Binding PeriodAnalytics.Operations}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserSortColumns="True" HeadersVisibility="Column"
                                  RowHeaderWidth="0" GridLinesVisibility="None" Background="White" BorderThickness="0"
                                  EnableRowVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  MinColumnWidth="70">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Operation.Date, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="145"/>
                                <DataGridTemplateColumn Header="Операция" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ProfitTooltip}">
                                                <Border Width="23" Height="23" Background="{Binding IconBrush}" CornerRadius="3" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding IconGlyph}" Foreground="White" FontSize="13" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Operation.TypeName}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Инструмент" Binding="{Binding Operation.InstrumentName}" Width="2*" MinWidth="190"/>
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Operation.Quantity, StringFormat={}{0:N0}}" Width="90"/>
                                <DataGridTextColumn Header="Цена" Binding="{Binding Operation.Price, StringFormat={}{0:N2}}" Width="110"/>
                                <DataGridTextColumn Header="Сумма" Binding="{Binding Operation.Amount, StringFormat={}{0:N2}}" Width="125"/>
                                <DataGridTextColumn Header="Валюта" Binding="{Binding Operation.Currency}" Width="75"/>
                                <DataGridTextColumn Header="Результат по цене" Binding="{Binding ProfitByPriceText}" Width="150"/>
                                <DataGridTextColumn Header="С купонами" Binding="{Binding ProfitIncludingCouponsText}" Width="145"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Grid.Row="4" Text="{Binding PeriodAnalytics.StatusMessage}" FontSize="10"
                               Foreground="{StaticResource MutedBrush}" Margin="4,7,0,0" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </TabItem>
            <TabItem Header="План инвестиций">
                <Grid Background="#F2F4F1" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,10">
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="13,11" Margin="0,0,6,0" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="КАПИТАЛ К ЦЕЛЕВОЙ ДАТЕ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding InvestmentPlan.ProjectedValueText}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="13,11" Margin="3,0" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="С ВЫПЛАЧЕННЫМИ КУПОНАМИ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding InvestmentPlan.ProjectedWealthText}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="13,11" Margin="3,0" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="ПЛАНОВЫЕ ВЗНОСЫ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding InvestmentPlan.ContributionsText}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="13,11" Margin="3,0" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="КУПОНЫ ВЫПЛАЧЕНЫ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding InvestmentPlan.PaidCouponsText}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="13,11" Margin="6,0,0,0" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="В ПОКУПАТЕЛЬНОЙ СПОСОБНОСТИ СЕГОДНЯ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding InvestmentPlan.RealValueText}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="365"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="15" Margin="0,0,10,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="Инвестиционный план" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Название" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4"/>
                                    <TextBox Text="{Binding InvestmentPlan.PlanName, UpdateSourceTrigger=LostFocus}" Height="30" Padding="7,4"/>

                                    <TextBlock Text="Параметры цели" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,7"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="145"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Дата начала" VerticalAlignment="Center" FontSize="11"/>
                                        <DatePicker Grid.Column="1" SelectedDate="{Binding InvestmentPlan.StartDate, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Grid.Row="1" Text="Горизонт, лет" VerticalAlignment="Center" FontSize="11"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InvestmentPlan.DurationYears, UpdateSourceTrigger=LostFocus}" Padding="7,4"/>
                                        <TextBlock Grid.Row="2" Text="Начальный капитал, ₽" VerticalAlignment="Center" FontSize="11"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding InvestmentPlan.InitialCapitalRub, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" Padding="7,4"/>
                                        <TextBlock Grid.Row="3" Text="Целевая сумма, ₽" VerticalAlignment="Center" FontSize="11"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding InvestmentPlan.TargetAmountRub, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" Padding="7,4"/>
                                    </Grid>

                                    <TextBlock Text="Пополнения" FontSize="13" FontWeight="SemiBold" Margin="0,15,0,7"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="145"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Сумма взноса, ₽" VerticalAlignment="Center" FontSize="11"/>
                                        <TextBox Grid.Column="1" Text="{Binding InvestmentPlan.ContributionAmountRub, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" Padding="7,4"/>
                                        <TextBlock Grid.Row="1" Text="Частота" VerticalAlignment="Center" FontSize="11"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding InvestmentPlan.ContributionFrequencyOptions}"
                                                  DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                                  SelectedValue="{Binding InvestmentPlan.ContributionFrequency}" VerticalContentAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Text="День месяца" VerticalAlignment="Center" FontSize="11"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding InvestmentPlan.ContributionDayOfMonth, UpdateSourceTrigger=LostFocus}" Padding="7,4"/>
                                        <TextBlock Grid.Row="3" Text="Рост взноса в год, %" VerticalAlignment="Center" FontSize="11"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding InvestmentPlan.AnnualContributionIncreasePercent, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" Padding="7,4"/>
                                    </Grid>

                                    <TextBlock Text="Доходность и расходы" FontSize="13" FontWeight="SemiBold" Margin="0,15,0,7"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="145"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Рост цены в год, %" VerticalAlignment="Center" FontSize="11"/>
                                        <TextBox Grid.Column="1" Text="{Binding InvestmentPlan.AnnualPriceGrowthPercent, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" Padding="7,4"/>
                                        <TextBlock Grid.Row="1" Text="Купонный доход, %" VerticalAlignment="Center" FontSize="11"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InvestmentPlan.AnnualCouponYieldPercent, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" Padding="7,4"/>
                                        <TextBlock Grid.Row="2" Text="Налог с купонов, %" VerticalAlignment="Center" FontSize="11"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding InvestmentPlan.CouponTaxPercent, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" Padding="7,4"/>
                                        <TextBlock Grid.Row="3" Text="Комиссия в год, %" VerticalAlignment="Center" FontSize="11"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding InvestmentPlan.AnnualFeePercent, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" Padding="7,4"/>
                                        <TextBlock Grid.Row="4" Text="Инфляция в год, %" VerticalAlignment="Center" FontSize="11"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding InvestmentPlan.AnnualInflationPercent, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" Padding="7,4"/>
                                    </Grid>
                                    <CheckBox Content="Реинвестировать купонный доход" IsChecked="{Binding InvestmentPlan.ReinvestCouponIncome}"
                                              Margin="0,10,0,3" FontSize="11"/>

                                    <Button Content="Рассчитать сценарий" Command="{Binding InvestmentPlan.RecalculateCommand}"
                                            Style="{StaticResource ActionButton}" Background="#E5EBDD" HorizontalAlignment="Stretch" Margin="0,14,0,0"/>
                                    <Button Content="Сохранить / обновить план" Command="{Binding InvestmentPlan.SaveCommand}"
                                            Style="{StaticResource ActionButton}" Background="#173B34" Foreground="White" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                                    <Button Content="Сверить с пополнениями счёта" Command="{Binding InvestmentPlan.RefreshActualsCommand}"
                                            Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Margin="0,8,0,8"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="260"/>
                                <RowDefinition Height="220"/>
                            </Grid.RowDefinitions>
                            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="3,0,3,7">
                                        <TextBlock Text="{Binding InvestmentPlan.GoalText}" FontSize="13" FontWeight="SemiBold" Foreground="#1D2C2A"/>
                                        <TextBlock Text="{Binding InvestmentPlan.CurrentGoalValueText}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,3"/>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding InvestmentPlan.CurrentGoalProgressPercent, Mode=OneWay}"
                                                     Height="6" Foreground="#2A7E5E" Background="#E8EDE9" BorderThickness="0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="Следующий взнос: " FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="{Binding InvestmentPlan.NextContributionText}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <oxy:PlotView Grid.Row="1" Model="{Binding InvestmentPlan.ProjectionPlotModel}"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8">
                                <DataGrid ItemsSource="{Binding InvestmentPlan.ContributionPeriods}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserSortColumns="True" HeadersVisibility="Column"
                                          RowHeaderWidth="0" GridLinesVisibility="None" Background="White" BorderThickness="0"
                                          EnableRowVirtualization="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Период взноса" Binding="{Binding StartDate, StringFormat={}{0:dd.MM.yyyy}}" Width="115"/>
                                        <DataGridTextColumn Header="План, ₽" Binding="{Binding PlannedAmountRub, StringFormat={}{0:N0}}" Width="100"/>
                                        <DataGridTextColumn Header="Факт, ₽" Binding="{Binding ActualAmountRub, StringFormat={}{0:N0}}" Width="100"/>
                                        <DataGridTextColumn Header="Разница, ₽" Binding="{Binding DifferenceRub, StringFormat={}{0:+#,0;-#,0;0}}" Width="100"/>
                                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="*" MinWidth="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="2" Background="#E8EDE9" Padding="14,8" Margin="0,10,0,0">
                        <TextBlock Text="{Binding InvestmentPlan.StatusMessage}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="#E8EDE9" Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#53615C" FontSize="11" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding LastUpdateText}" Foreground="#687773" FontSize="10" Margin="18,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding LastPriceText}" Foreground="#687773" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>