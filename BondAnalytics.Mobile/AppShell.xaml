<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BondAnalytics.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#07111F}"
    Shell.ForegroundColor="{AppThemeBinding Light=#233544, Dark=#EAF0F6}"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0B1724}"
    Shell.TabBarForegroundColor="{AppThemeBinding Light=#14795B, Dark=#75D6B7}"
    Shell.TabBarTitleColor="{AppThemeBinding Light=#14795B, Dark=#75D6B7}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light=#687786, Dark=#718397}"
    Shell.NavBarIsVisible="False">
</Shell>
